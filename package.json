{
  "name": "famtask",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning test/*.test.ts",
    "cli": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply famtask --local",
    "db:migrate": "wrangler d1 migrations apply famtask --remote",
    "eval": "node --experimental-strip-types --disable-warning=ExperimentalWarning evals/run.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/node": "^26.5.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.131.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0"
  }
}
